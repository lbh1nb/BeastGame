{
  "appId": "com.beastgame.app",
  "productName": "BeastGame",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "out/**/*"
  ],
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist/sql-wasm.wasm",
      "to": "native/sql-wasm.wasm"
    },
    {
      "from": "resources",
      "to": ".",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icon.png",
    "signAndEditExecutable": false
  }
}
